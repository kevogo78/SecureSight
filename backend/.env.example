# ==============================================================================
# SecureSight Backend API - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the FastAPI backend:
#   cp .env.example .env
#
# Replace all placeholder values marked with <YOUR_...> with your actual settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Amazon RDS PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# The hostname / endpoint provided in the AWS RDS Console (without port or prefix)
DB_HOST=<YOUR_RDS_ENDPOINT>.us-east-1.rds.amazonaws.com
DB_NAME=postgres
DB_USER=postgresadmin
DB_PASS=<YOUR_SECURE_RDS_PASSWORD>
DB_PORT=5432
DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# 2. Amazon S3 Media & Compliance Bucket Settings
# ------------------------------------------------------------------------------
# Name of your dedicated private S3 bucket for screenshots and keystroke logs
S3_BUCKET=<YOUR_S3_BUCKET_NAME>
AWS_REGION=us-east-1

# Optional IAM User credentials (if not using an EC2 Instance IAM Role)
# When deploying on an EC2 instance with an IAM Role attached, leave these blank.
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

# ------------------------------------------------------------------------------
# 3. Administrator Authentication & Session Security
# ------------------------------------------------------------------------------
# Administrator credentials for dashboard sign-in
DASHBOARD_ADMIN_USER=administrator
DASHBOARD_ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# Cryptographic secret for signing HTTP-only administrator session cookies
# Must be at least 32 characters. Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
DASHBOARD_SESSION_SECRET=<YOUR_RANDOM_SECRET_AT_LEAST_32_CHARS>

# Set to true when running over HTTPS (SSL). Set to false only for HTTP IP development testing.
DASHBOARD_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Cryptographic Screenshot Decryption Key
# ------------------------------------------------------------------------------
# 256-bit hexadecimal key (64 hex characters) matching the client agent configuration.
# Used by the server to decrypt AES-256-GCM encrypted screen captures on-demand.
SCREENSHOT_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. Application Security & CORS
# ------------------------------------------------------------------------------
SECRET_KEY=<YOUR_RANDOM_APPLICATION_SECRET_KEY>
# Comma-separated list of additional allowed browser origins (optional)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

