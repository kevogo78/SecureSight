# ==============================================================================
# SecureSight Client Desktop Agent - Environment Overrides (Optional)
# ==============================================================================
# If present, variables in this file override settings in agent/config/config.json.
# Copy this template to .env to use environment-based configuration:
#   cp .env.example .env
# ==============================================================================

# Target FastAPI Telemetry Ingestion Endpoint on AWS EC2 or localhost
EDMT_SERVER_URL=http://<YOUR_EC2_PUBLIC_IP>/api/v1/telemetry

# Workstation 256-bit AES-GCM media encryption key (64 hex characters)
# Must match the SCREENSHOT_KEY_HEX defined on the backend server
EDMT_CRYPTO_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Target Amazon S3 bucket for compliance keystroke snapshots and captures
S3_BUCKET_NAME=<YOUR_S3_BUCKET_NAME>
AWS_REGION=us-east-1

# Optional AWS credentials if direct S3 client upload is enabled on the agent
# AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>

